rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン中ユーザー自身のユーザードキュメントから role を取得し、
    // 管理者かどうかを判定するヘルパー。
    function isSignedIn() {
      return request.auth != null;
    }

    // 管理者権限は「一般管理者(admin)」「最高管理者(super_admin)」の2階層。
    // isAdmin(): どちらでも true(閲覧系の権限判定用)
    // isSuperAdmin(): 最高管理者のみ true(役割変更・削除など事故防止のため制限された操作用)
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // ------------------------------------------------------------
    // users: 社員マスタ(氏名・社員番号・役割など)
    // - 読み取り: ログイン済みなら誰でも可(日報の作成者名表示・管理画面の社員一覧に必要)
    // - 作成: 管理者(一般/最高)が可能。ただし一般管理者は"一般作業員(staff)"としてのみ
    //   新規社員を作成できる。管理者権限を持つ社員の新規作成は最高管理者のみ
    //   (一般管理者が他人に管理者権限を付与できてしまう事故を防止)。
    // - 更新/削除: 最高管理者のみ(役割変更・社員削除による事故を防止するため、
    //   一般管理者には許可しない)。
    // ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() &&
        (request.resource.data.role == 'staff' || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------
    // work_reports: 日報
    // - 読み取り: ログイン済みなら誰でも可(検索・管理ダッシュボードに必要)
    // - 作成: 本人の日報としてのみ作成可(author_id が自分のuidであること)
    // - 更新/削除: 本人 または 管理者のみ
    //   【2026-08追加】現場での入力もれ・訂正対応のため、一般管理者以上
    //   (admin/super_admin)には本人以外の日報も更新できる権限を付与している
    //   (このルール自体は元々admin/super_adminを許可済みだったため変更なし)。
    //   アプリ側(report_edit_screen.dart)で、本人以外が編集した場合のみ
    //   last_edited_by_admin_* フィールドへ代筆記録を残す運用にすることで、
    //   無記録での代筆編集が起きない設計にしている。
    // ------------------------------------------------------------
    match /work_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.author_id == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------
    // stores: 店舗マスタ
    // - 管理者/一般作業員問わず全員が閲覧・編集可能(意図的な仕様)
    // ------------------------------------------------------------
    match /stores/{storeId} {
      allow read, write: if isSignedIn();
    }

    // ------------------------------------------------------------
    // app_config: 強制アップデートゲート等のアプリ全体設定
    // - 読み取り: ログイン済みなら誰でも可(起動時のバージョンチェックに必要)
    // - 更新: 最高管理者のみ(誤操作で全社ロックアウトになる事故を防ぐため)
    // ------------------------------------------------------------
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ------------------------------------------------------------
    // monthly_export_status: 月次CSVエクスポート(SE/プロワン/社内業務)の
    // 実施状況記録(管理者ダッシュボードのリマインド表示用)
    // - 読み取り: ログイン済みなら誰でも可(リマインド表示に必要)
    // - 書き込み: 管理者(一般/最高)のみ
    // ------------------------------------------------------------
    match /monthly_export_status/{monthKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // cases: 「案件」自動グルーピング(2026-08導入)
    // 複数の日報(伝票No/受付No一致、または内容類似度による推測)を
    // 横断的にまとめて管理するためのコレクション。CaseServiceが
    // 日報の保存(作成・更新)の都度、裏側で自動的に作成・更新する。
    // - 読み取り: ログイン済みなら誰でも可(検索画面「案件」タブ・
    //   日報詳細の「この案件の他の日報」セクションで全員が閲覧するため)
    // - 作成/更新/削除: ログイン済みなら誰でも可。CaseServiceが日報の
    //   保存(本人 or 管理者による作成・更新・削除)に付随して裏側で
    //   自動的に案件ドキュメントを作成・更新・(最後の1件が切り離された
    //   場合のみ)削除するため、work_reportsの操作権限と整合させている。
    //   案件の手動削除UIはアプリ側に存在せず、CaseService経由の処理
    //   でのみ書き込まれる。
    // ------------------------------------------------------------
    match /cases/{caseId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ------------------------------------------------------------
    // 【廃止・2026-08-28】prowan_job_cache コレクションは、プロワン本体との
    // リアルタイムAPI連携が現実的でないと判断し、CSV照合方式そのものを
    // 廃止したため削除した(経緯: system_architecture_data.dart の
    // consideredButNotAdopted、changelog_data.dart 参照)。
    // 代わりに、作業報告書PDFをAI-OCRで直接読み取り、18項目全てを
    // 各フォーム欄へ直接反映する方式に切り替えている。
    // 併せて、このコレクションを読み書きしていたバックエンドスクリプト
    // 一式(旧 csv_cache_backend/)、Flutterモデル(旧 prowan_job_cache.dart)、
    // サービス(旧 prowan_job_cache_service.dart)も削除済み。
    // ------------------------------------------------------------

    // ------------------------------------------------------------
    // submission_checks: 月末チェック(日報記入率)機能の突合結果
    // 紙報告書PDFをOCR解析し、アプリ側日報データと突合した結果を
    // 月(check_month, "yyyy-MM")ごとに記録する。
    // - 読み取り: ログイン済みなら誰でも可(結果確認のため)
    // - 書き込み: 管理者(一般/最高)のみ。月末チェック機能自体が
    //   管理画面からのみ実行可能なため、書き込み権限も管理者に限定する。
    // ------------------------------------------------------------
    match /submission_checks/{recordId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // scan_corrections: AI-OCR(Azure Document Intelligence)の抽出値と
    // ユーザーがScanConfirmScreenで最終確定した値との差分ログ(2026-08-28導入)。
    // Azure側には本番解析結果からの自動継続学習機能がないため、次回の
    // 手動モデル再学習でどのフィールドを優先的に改善すべきかを判断する
    // ための収集用データ。個人が特定できる元PDF/画像は含まず、
    // フィールド単位のテキスト差分のみを保持する。
    // - 読み取り: 管理者(一般/最高)のみ(現場ユーザーには不要な情報のため)
    // - 作成: ログイン済みなら誰でも可(スキャン機能を使う全ユーザーが
    //   自分の手直し内容を記録できる必要があるため)
    // - 更新/削除: 行わない運用(蓄積ログのため、事故防止のため不可)
    // ------------------------------------------------------------
    match /scan_corrections/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // case_sync_failures: 「日報→案件」自動グルーピング処理
    // (CaseService.syncCaseForReport)の失敗記録(2026-08-31導入)。
    // 従来は失敗してもデバッグログのみで本番からは見えなかった問題への
    // 対応として、失敗をここへ記録し、案件一覧画面(管理者用)から
    // 一覧・再試行・解決済みマークができるようにする。
    // ドキュメントIDは対象日報のreportIdと同一(=同一日報の失敗記録は
    // 上書きされ、複数レコードが積み上がらない)。
    // - 読み取り: 管理者(一般/最高)のみ(現場ユーザーには不要な情報のため)
    // - 作成/更新: ログイン済みなら誰でも可。日報保存(本人 or 管理者)に
    //   付随してAppState._syncCaseSilentlyが裏側で自動的に書き込むため、
    //   work_reportsの操作権限と整合させている。
    // - 削除: ログイン済みなら誰でも可(再同期成功時の自動クリア、
    //   および管理者による「解決済みにする」操作の両方で必要)。
    // ------------------------------------------------------------
    match /case_sync_failures/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSignedIn();
    }

    // その他の未定義コレクションはデフォルトで拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
