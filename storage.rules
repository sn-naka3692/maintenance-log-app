rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 日報の写真: report_photos/{reportId}/{fileName}
    // - 読み取り: ログイン済みなら誰でも可(日報詳細画面での写真閲覧に必要。
    //   Firestore側のwork_reportsルールと同じ方針)
    // - 書き込み: ログイン済みユーザーのみ。1ファイル10MBまで、画像ファイルのみ許可
    //   (誤って大容量ファイルや実行ファイル等がアップロードされる事故を防止)
    match /report_photos/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // 上記以外は全て拒否(デフォルト拒否・想定外パスへのアクセスを防止)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
